---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Projects | Jason Garvin";
const description = "Explore Jason Garvin's personal and professional projects, view the documentation, and check out the source code where applicable.";
const canonicalUrl = "https://jasongarvin.com/projects/";
---

<BaseLayout
  description={description}
  title={title}
  canonicalUrl={canonicalUrl}>

  <main id="main-content">

    <section class="hero-content top-of-page centered transparent-bg">
      <h1 class="cta-header">My Projects</h1>
      <p class="subtitle">
        See what I'm cooking up
      </p>
    </section>

    <section class="vertical-space">
      <h2>Current Projects</h2>
      <p>
        It's no secret that I love building new things, whether in software or
        otherwise. What I'm not as great about sharing, however, tends to be the
        results of those projects.
      </p>
      <p>
        So I made this page! That way I can share what I'm working on, include
        notes from each project, document my journey, and give back to the
        online communities that have helped me grow and learn.
      </p>
    </section>

    <div class="vertical-space card-flex">
      <section class="active-card width-50">
        <div>
          <h2>
            Sustainability
          </h2>
          <div class="tags">
            <span class="tag">Sustainability</span>
            <span class="tag">Business</span>
          </div>
        </div>

        <div>
          <p>
            I've been putting together Sustainability resources to help ease
            you into the topic, approach it in small steps, and learn how to get
            involved&mdash;especially if you're a business owner.
          </p>
        </div>

        <a class="default-button bottom-space" href="/projects/sustainability">
          Learn More
        </a>
      </section>

      <section class="width-50">
        <div>
          <h2>
            Pokewrap
          </h2>
          <div class="tags">
            <span class="tag">Technology</span>
            <span class="tag">Software</span>
          </div>
        </div>

        <div>
          <p>A Python library to abstract away requesting Pok&eacute;mon info.</p>
          <p>
            Pokewrap is a lightweight wrapper library for consuming
            <a href="https://pokeapi.co/" target="_blank" rel="external">PokeAPI</a>,
            making it easier to request Pok&eacute;mon game data to import it
            into your projects.
          </p>
        </div>

        <a class="default-button bottom-space" href="/projects/pokewrap">
          Explore the Docs
        </a>
      </section>

      <section class="inactive-card width-100 centered">
        <h2>
          Coming Soon
        </h2>
        <p>
          I have more projects in the works!
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
